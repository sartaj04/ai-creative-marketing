# =============================================================================
# Pixo — environment template
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# App
APP_NAME=Pixo
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL). asyncpg is added automatically if you use postgresql://
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pixo

# Redis (Celery broker + result backend). Use rediss:// for TLS (e.g. Upstash)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM routing: gemini (cheap/fast) or bedrock (Claude, heavier tasks)
AI_PROVIDER=gemini
LLM_PRIMARY_PROVIDER=gemini
LLM_COMPLEX_PROVIDER=bedrock

# Google Gemini / Vertex AI
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# AWS S3 (media uploads, rendered templates)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1

# AWS Bedrock (Claude)
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional integrations
APIFY_TOKEN=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
YOUTUBE_PROXY_URL=
YOUTUBE_PROXY_API_KEY=

# Frontend (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_APP_NAME=Pixo
