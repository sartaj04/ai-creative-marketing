# BrandScale AI - Environment Variables Template
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=BrandScale AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brandscale

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24

# =============================================================================
# OPENAI API
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# AWS S3
# =============================================================================
# Create an S3 bucket and IAM user with S3 permissions
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=brandscale-assets

# Optional: CloudFront domain for faster asset delivery
# AWS_CLOUDFRONT_DOMAIN=d123456789.cloudfront.net

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================
# Sentry (error tracking): https://sentry.io
# SENTRY_DSN=https://your-sentry-dsn
