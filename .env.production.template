# Pixo Production Environment Template
# Copy to .env.production and fill in values

# === Database ===
DB_USER=pixo
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=pixo_db

# === Redis ===
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# === JWT ===
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# === AI ===
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key-optional

# === AWS S3 ===
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=pixo-assets-prod
AWS_S3_REGION=ap-south-1
AWS_CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net

# === Razorpay ===
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# === Domain & SSL ===
DOMAIN=pixo.ai
ACME_EMAIL=admin@pixo.ai
ALLOWED_ORIGINS=https://pixo.ai,https://www.pixo.ai

# === Traefik Dashboard (optional) ===
# Generate with: htpasswd -nb admin password | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz...
