# Node.js Render Service Environment Variables

# Server
NODE_ENV=development
PORT=3001

# ============================================
# AWS S3 CREDENTIALS
# Used for uploading rendered images
# Can share with Python backend
# ============================================
AWS_S3_ACCESS_KEY_ID=your-s3-access-key
AWS_S3_SECRET_ACCESS_KEY=your-s3-secret-key
AWS_S3_BUCKET=pixo-assets
AWS_S3_REGION=ap-south-1
AWS_CLOUDFRONT_DOMAIN=

# ============================================
# AWS BEDROCK CREDENTIALS
# Used for Claude image analysis
# Typically in us-east-1 or us-west-2
# May use DIFFERENT IAM user than S3
# ============================================
AWS_BEDROCK_ACCESS_KEY_ID=your-bedrock-access-key
AWS_BEDROCK_SECRET_ACCESS_KEY=your-bedrock-secret-key
AWS_BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ============================================
# UNSPLASH API
# For background image search
# ============================================
UNSPLASH_APP_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

